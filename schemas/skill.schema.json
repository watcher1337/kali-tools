{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/watcher1337/kali-tools/schemas/skill.schema.json",
  "title": "Kali-tools skill frontmatter",
  "description": "Portable SKILL.md contract. The canonical file lives at skills/<id>/SKILL.md.",
  "type": "object",
  "required": ["name", "description", "license", "metadata"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 1024},
    "license": {"const": "GPL-3.0-only"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "type", "status", "source", "capabilities", "activation", "prerequisites", "verification"],
      "properties": {
        "category": {"enum": ["master", "network-reconnaissance", "dns-infrastructure", "web-discovery", "vulnerability-assessment", "smb-active-directory", "web-application", "password-auditing", "privilege-escalation", "wireless", "forensics", "exploitation", "systems-utilities"]},
        "type": {"enum": ["tool", "master"]},
        "status": {"enum": ["curated", "starter"]},
        "source": {"enum": ["manual", "generated"]},
        "verification": {"enum": ["kali-help", "official-docs", "none"]},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["shell", "network", "root", "credentials", "wordlists", "gpu", "interactive-gui", "wireless-hardware", "evidence-handling"]}},
        "activation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "prerequisites": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "executable": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9._+-]+$"}},
        "package": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9.+_-]+$"}},
        "related": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
        "aliases": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
        "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}}
      }
    }
  }
}
