{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/watcher1337/kali-tools/schemas/tool.schema.json",
  "title": "Kali-tools manifest skill record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "path", "category", "type", "status", "source", "aliases", "dependencies", "format", "verification", "required_capabilities", "activation", "prerequisites", "related_skills", "supported_platforms"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "name": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 1024},
    "path": {"type": "string", "pattern": "^skills/[a-z0-9]+(-[a-z0-9]+)*/SKILL\\.md$"},
    "category": {"type": "string"},
    "type": {"enum": ["tool", "master"]},
    "status": {"enum": ["curated", "starter"]},
    "source": {"enum": ["manual", "generated"]},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "format": {"const": 1},
    "verification": {"enum": ["kali-help", "official-docs", "none"]},
    "executable": {"type": "array", "items": {"type": "string"}},
    "package": {"type": "array", "items": {"type": "string"}},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "activation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "prerequisites": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "related_skills": {"type": "array", "items": {"type": "string"}},
    "supported_platforms": {"type": "array", "minItems": 1, "items": {"enum": ["generic", "opencode", "claude-code", "codex", "cursor"]}}
  }
}
